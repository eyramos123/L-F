rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Rules for Report Photos
    match /reports/{reportId}/{imageName} {
      // Authenticated users can view report photos
      allow read: if isSignedIn();
      
      // Authenticated users can upload photos for reports:
      // - Must be signed in
      // - Image file size must be less than 5MB
      // - File must be a valid image format
      allow write: if isSignedIn() 
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }

    // Rules for User Profile Pictures
    match /profiles/{userId}/{imageName} {
      // Authenticated users can view user profiles
      allow read: if isSignedIn();
      
      // Users can only upload and update their own profile picture:
      // - Must be signed in and own the profile directory
      // - Profile image size must be less than 2MB
      // - File must be a valid image format
      allow write: if isSignedIn() 
                   && request.auth.uid == userId 
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
